# Gemini. Set only ONE of these -- if both are set the SDK prefers GOOGLE_API_KEY
# and logs a warning. https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# Google limits 2.5-era models to projects that already used them, so new keys
# should stay on a 3.x GA model.
GEMINI_MODEL=gemini-3.5-flash

# Optional: email enrichment. Absent key disables enrichment, never crashes.
HUNTER_API_KEY=

COMPANY_RESEARCH_TTL_DAYS=7
SCRAPE_INTERVAL_SECONDS=600
AGENT_POLL_INTERVAL_SECONDS=5

DB_PATH=./data/jobradar.db

# Runs the scrape loop inside the Flask process. Local dev convenience only --
# leave false under Docker, where scraper-worker owns the loop.
RUN_SCRAPER_IN_APP=false

# Port the Flask dev server binds when you run `python app.py` directly.
# Under Docker, gunicorn always binds 8000 inside the container.
API_PORT=8000

# Host ports published by Docker Compose. 8000/5173 are commonly taken by other
# local stacks, so JobRadar publishes 8088/5174 by default.
API_HOST_PORT=8088
UI_HOST_PORT=5174

CORS_ORIGINS=http://localhost:5173
